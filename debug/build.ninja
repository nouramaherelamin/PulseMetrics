  LINK_LIBRARIES = libpulsecore.a  libpulse_sqlite.a  libpulse_json.a  -lws2_32  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = CMakeFiles\test_contract.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\test_contract.dir\
  TARGET_FILE = bin\test_contract.exe
  TARGET_IMPLIB = libtest_contract.dll.a
  TARGET_PDB = bin\test_contract.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\test_contract.dir


